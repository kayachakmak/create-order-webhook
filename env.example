# PostgreSQL
POSTGRES_USER=orders
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=orders

# Traefik — adjust to match your existing Traefik setup
DOMAIN=webhook.your-domain.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Optional bearer token for read endpoints (e.g. POST /orders/by-conversations).
# Empty/unset = no auth check (current local behavior). Set to a strong random
# string in production; clients must then send `Authorization: Bearer <token>`.
WEBHOOK_API_TOKEN=
